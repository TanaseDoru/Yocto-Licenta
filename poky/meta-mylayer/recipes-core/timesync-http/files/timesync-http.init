#!/bin/sh
### BEGIN INIT INFO
# Provides:          timesync-http
# Required-Start:    $network
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:
# Short-Description: Set system time from HTTP Date header
### END INIT INFO

URL="http://example.com"
SLEEP_SECS=5
LOG="/var/log/timesync-http.log"

get_http_date() {
  # Get raw headers from wget and extract the Date header (RFC1123)
  wget -S --spider "$URL" 2>&1 \
    | grep -i '^ *Date:' \
    | head -n 1 \
    | sed 's/^[[:space:]]*[Dd]ate:[[:space:]]*//'
}

rfc1123_to_iso() {
  # Input: "Fri, 30 Jan 2026 21:36:20 GMT"
  # Output: "2026-01-30 21:36:20"
  set -- $(echo "$1" | tr -d ',')
  DAY="$2"; MON="$3"; YEAR="$4"; TIME="$5"

  case "$MON" in
    Jan) MM=01;; Feb) MM=02;; Mar) MM=03;; Apr) MM=04;;
    May) MM=05;; Jun) MM=06;; Jul) MM=07;; Aug) MM=08;;
    Sep) MM=09;; Oct) MM=10;; Nov) MM=11;; Dec) MM=12;;
    *) return 1;;
  esac

  echo "${YEAR}-${MM}-${DAY} ${TIME}"
}

have_internet() {
  # Fast check: can reach an IP (avoids DNS dependency)
  ping -c 1 -W 1 1.1.1.1 >/dev/null 2>&1
}

do_sync() {
  echo "[timesync-http] waiting for internet..." >> "$LOG"

  # 1) Wait until internet is available (forever)
  while ! have_internet; do
    sleep "$SLEEP_SECS"
  done

  echo "[timesync-http] internet OK, fetching HTTP Date..." >> "$LOG"

  # 2) Fetch Date header until we can parse it and set time (forever)
  while :; do
    DATE_STR="$(get_http_date)"
    if [ -n "$DATE_STR" ]; then
      ISO="$(rfc1123_to_iso "$DATE_STR" 2>/dev/null || true)"
      if [ -n "$ISO" ]; then
        # Set UTC time
        if date -u -s "$ISO" >/dev/null 2>&1; then
          echo "[timesync-http] set UTC time: $ISO (from: $DATE_STR)" >> "$LOG"
          break
        fi
      fi
    fi
    sleep "$SLEEP_SECS"
  done

  # Optional: if you still run ntpd, restart it after time is valid
  # /etc/init.d/ntpd restart >/dev/null 2>&1 || true
}

case "$1" in
  start)
    # Run in background so boot doesn't hang forever waiting for internet
    do_sync &
    ;;
  stop)
    # No persistent daemon, nothing to stop
    ;;
  restart)
    $0 start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac

exit 0
