#!/bin/sh
### BEGIN INIT INFO
# Provides:          htu21d-client
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: HTU21D client daemon
# Description:       Reads HTU21D over I2C and sends readings to data-collector
### END INIT INFO

DAEMON="/usr/bin/htu21d-client"
PIDFILE="/var/run/htu21d-client.pid"
LOG_FILE="/var/log/htu21d-client.log"

start() {
    echo "Starting htu21d-client..."
    touch "$LOG_FILE"
    if [ -x "$DAEMON" ]; then
        start-stop-daemon --start --quiet --background \
            --make-pidfile --pidfile "$PIDFILE" --exec "$DAEMON" -- \
            >> "$LOG_FILE" 2>&1
    else
        echo "$DAEMON not found or not executable"
        return 1
    fi
}

stop() {
    echo "Stopping htu21d-client..."
    if [ -f "$PIDFILE" ]; then
        start-stop-daemon --stop --quiet --pidfile "$PIDFILE" --retry 5
        rm -f "$PIDFILE"
    else
        killall htu21d-client 2>/dev/null || true
    fi
}

status() {
    if [ -f "$PIDFILE" ]; then
        pid=$(cat "$PIDFILE")
        if [ -d "/proc/$pid" ]; then
            echo "htu21d-client running (pid $pid)"
            return 0
        fi
    fi
    echo "htu21d-client not running"
    return 1
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        sleep 1
        start
        ;;
    status)
        status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0
