#!/bin/sh
### BEGIN INIT INFO
# Provides:          chrony
# Required-Start:    $local_fs $network
# Required-Stop:     $local_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: chrony NTP daemon
# Description:       Sincronizare ceas sistem cu servere NTP prin chrony.
### END INIT INFO

NAME="chronyd"
DAEMON="/usr/sbin/chronyd"
PIDFILE="/var/run/chronyd.pid"
CONFIG="/etc/chrony.conf"

[ -x "$DAEMON" ] || { echo "$DAEMON nu există sau nu e executabil"; exit 1; }
[ -f "$CONFIG" ] || { echo "$CONFIG lipsește"; exit 1; }

start() {
    echo -n "Pornire $NAME: "

    if [ -f "$PIDFILE" ]; then
        PID=$(cat "$PIDFILE")
        if kill -0 "$PID" 2>/dev/null; then
            echo "deja rulează (PID $PID)"
            return 1
        else
            rm -f "$PIDFILE"
        fi
    fi

    start-stop-daemon --start \
        --quiet \
        --pidfile "$PIDFILE" \
        --exec "$DAEMON" \
        -- -f "$CONFIG"

    RETVAL=$?
    if [ $RETVAL -eq 0 ]; then
        echo "OK"
    else
        echo "EROARE (cod $RETVAL)"
    fi
    return $RETVAL
}

stop() {
    echo -n "Oprire $NAME: "

    if [ ! -f "$PIDFILE" ]; then
        echo "nu rulează"
        return 1
    fi

    start-stop-daemon --stop \
        --quiet \
        --pidfile "$PIDFILE" \
        --signal TERM \
        --retry 5

    RETVAL=$?
    if [ $RETVAL -eq 0 ]; then
        rm -f "$PIDFILE"
        echo "OK"
    else
        echo "EROARE (cod $RETVAL)"
    fi
    return $RETVAL
}

status() {
    if [ -f "$PIDFILE" ]; then
        PID=$(cat "$PIDFILE")
        if kill -0 "$PID" 2>/dev/null; then
            echo "$NAME rulează (PID $PID)"
            chronyc tracking 2>/dev/null
            return 0
        else
            echo "$NAME are PID file stale (PID $PID mort)"
            return 1
        fi
    else
        echo "$NAME nu rulează"
        return 3
    fi
}

restart() {
    stop
    sleep 1
    start
}

case "$1" in
    start)   start   ;;
    stop)    stop    ;;
    restart) restart ;;
    status)  status  ;;
    *)
        echo "Utilizare: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit $?